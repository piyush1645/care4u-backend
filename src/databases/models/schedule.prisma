model Schedule {
  id               BigInt    @id @default(autoincrement())
  morningStartTime DateTime? @map("morning_start_time")
  morningEndTime   DateTime? @map("morning_end_time")
  eveningStartTime DateTime? @map("evening_start_time")
  eveningEndTime   DateTime? @map("evening_end_time")
  workingDays      String    @map("working_days")
  doctorId         BigInt    @map("doctor_id")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  doctor           Doctor    @relation(fields: [doctorId], references: [id])

  @@map("doctor_schedules")
}
