model UserCredential {
  id             BigInt   @id @default(autoincrement())
  email          String   @unique
  mobile         String   @unique
  hashedPassword String
  role           Role
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  admin          Admin?
  doctor         Doctor?
  patient        Patient?
  staff          Staff?

  @@map("credentials")
}

enum Role {
  PATIENT
  ADMIN
  STAFF
  DOCTOR
  SUPER_ADMIN
}
