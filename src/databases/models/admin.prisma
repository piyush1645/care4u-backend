model Admin {
  id              BigInt         @id @default(autoincrement())
  firstName       String         @map("first_name")
  lastName        String         @map("last_name")
  hospitalGroupId BigInt         @unique @map("hospital_group_id")
  credentialId    BigInt         @unique @map("credential_id")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  credential      UserCredential @relation(fields: [credentialId], references: [id])
  hospitalGroup   HospitalGroup  @relation(fields: [hospitalGroupId], references: [id])

  @@map("admins")
}
